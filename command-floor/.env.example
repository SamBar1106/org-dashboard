# Optional HTTPS URL for GET /api/command-floor. Leave unset to use data/command-floor.json.
# The public GitHub Pages build must not point this at loopback. http://127.0.0.1,
# localhost, and any non-https URL are ignored and the published seed is used instead.
# VITE_COMMAND_FLOOR_URL=https://example.com/api/command-floor
